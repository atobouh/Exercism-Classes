{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octet",
  "version": "0.3.0",
  "identifier": "app.octet.desk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Octet",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "backgroundColor": "#FBFAF8",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../content": "content"
    },
    "category": "Education",
    "shortDescription": "A personal CCNA library and lab",
    "copyright": "",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    }
  }
}
